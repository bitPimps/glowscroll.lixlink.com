{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-code-review.sh",
            "timeout": 30,
            "statusMessage": "Checking code review before merge"
          }
        ]
      }
    ]
  }
}
