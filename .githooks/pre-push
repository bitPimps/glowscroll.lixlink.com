#!/usr/bin/env bash
# Git pre-push hook (enabled by `git config core.hooksPath .githooks`, which
# scripts/install-hooks.sh and the SessionStart hook in .claude/settings.json
# set). Refuses to update main on the remote unless the commit being pushed is
# the one scripts/mark-reviewed.sh recorded after a /code-review. See AGENTS.md.
set -uo pipefail
reviewed=$(cat "$(git rev-parse --absolute-git-dir)/code-review-ok" 2>/dev/null || true)
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ "$local_sha" = "$zero" ]; then
    echo "Deleting main is blocked." >&2
    exit 1
  fi
  if [ "$local_sha" != "$reviewed" ]; then
    echo "Push to main blocked: ${local_sha:0:9} has no code review." >&2
    echo "Run /code-review high against main, fix or answer every finding, commit, run the" >&2
    echo "checks in AGENTS.md, then scripts/mark-reviewed.sh and push again." >&2
    echo "(Last reviewed commit: ${reviewed:-none})" >&2
    exit 1
  fi
done
exit 0
